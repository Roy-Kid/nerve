{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "out-test",
    "declaration": false,
    "sourceMap": false,
    "types": ["node", "mocha"]
  },
  "include": [
    "tests/**/*.ts",
    "src/model/**/*.ts",
    "src/hub/**/*.ts",
    "src/store/**/*.ts",
    "src/focus/**/*.ts"
  ]
}
