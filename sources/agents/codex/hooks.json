{
  "description": "Nerve status hub — Codex agent lifecycle → local ingest (http://127.0.0.1:17890). Replace __NERVE_HOOK__ with: NERVE_SOURCE=codex python3 /ABS/PATH/TO/nerve/plugins/nerve/hooks/nerve_hook.py",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5,
            "statusMessage": "Nerve"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5,
            "statusMessage": "Nerve"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NERVE_SOURCE=codex __NERVE_HOOK__",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
